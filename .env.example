# Copy to .env (local) and Vercel project env (production).

DATABASE_URL="file:./dev.db"
# Production (Neon Postgres): change prisma/schema.prisma provider to "postgresql"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
AUTH_URL="http://localhost:3000"
# Production: AUTH_URL="https://your-domain.vercel.app"

# Instant email sign-in (no magic link). Leave true until Google/Resend are live.
AUTH_ALLOW_EMAIL_LOGIN="true"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — Google OAuth (Auth.js)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — magic-link email
RESEND_API_KEY=""
EMAIL_FROM="Pulseboard <login@pulseboard.app>"

# Stripe (live keys required for real paying users)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: Price IDs from Stripe Dashboard. If empty, Checkout uses price_data ($12/mo, $99/yr).
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
