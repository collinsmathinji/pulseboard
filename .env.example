# Copy to .env (local) and Vercel project env (production).

# Supabase Postgres — transaction pooler (Prisma queries)
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1"
# Supabase Postgres — session pooler (prisma db push / migrate)
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
AUTH_URL="http://localhost:3000"
# Production: AUTH_URL="https://www.pulseboard.lol"

# Instant email sign-in (no magic link). Leave true until Google/Resend are live.
AUTH_ALLOW_EMAIL_LOGIN="true"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — site-wide Google Analytics / Tag Manager (marketing + app)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# Optional — Pulseboard social profiles (landing footer, Open Graph, JSON-LD)
NEXT_PUBLIC_X_HANDLE=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_MARKETING_URL=""

# Optional — Google OAuth (Auth.js)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — magic-link email
RESEND_API_KEY=""
EMAIL_FROM="Pulseboard <login@pulseboard.app>"

# Stripe (live keys required for real paying users)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: Price IDs from Stripe Dashboard. If empty, Checkout uses price_data ($12/mo, $99/yr).
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
